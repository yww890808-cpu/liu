# ===== 复制为 .env 后填写，.env 不要提交到 Git =====

# 数据库：开发可用 SQLite；docker-compose 中使用 PostgreSQL
DATABASE_URL=sqlite:///./dev.db
# DATABASE_URL=postgresql+psycopg://ozon:ozon@localhost:5432/ozon

REDIS_URL=redis://localhost:6379/0

# Api-Key 加密密钥（Fernet）。生成方式：
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# JWT 签名密钥，填一个足够长的随机字符串
JWT_SECRET=
JWT_EXPIRE_MINUTES=720

# Ozon API
OZON_BASE_URL=https://api-seller.ozon.ru
OZON_RATE_LIMIT_PER_SEC=5
OZON_MAX_RETRIES=3
OZON_TIMEOUT_SEC=30

# 试运行模式：开启时，备货/改库存/回传单号等写操作只记录不提交
DRY_RUN=true

# 定时任务频率
ORDER_SYNC_INTERVAL_MINUTES=10
ORDER_SYNC_LOOKBACK_DAYS=3
STOCK_PUSH_INTERVAL_MINUTES=30
PRODUCT_SYNC_HOUR=3

# 面单 PDF 存放目录
LABEL_DIR=./data/labels
